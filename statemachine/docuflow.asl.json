{
  "Comment": "DocuFlow AI - Resilient Serverless Document & Invoice Intelligence Orchestration",
  "StartAt": "ParallelAnalysis",
  "States": {
    "ParallelAnalysis": {
      "Type": "Parallel",
      "Comment": "Executes concurrent entity extraction and security compliance scanning",
      "Branches": [
        {
          "StartAt": "ExtractEntities",
          "States": {
            "ExtractEntities": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "OutputPath": "$.Payload",
              "Parameters": {
                "FunctionName": "${ExtractorFunctionArn}",
                "Payload.$": "$"
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "SecurityScan",
          "States": {
            "SecurityScan": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "OutputPath": "$.Payload",
              "Parameters": {
                "FunctionName": "${ValidatorFunctionArn}",
                "Payload.$": "$"
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.parallel_results",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleWorkflowFailure"
        }
      ],
      "Next": "CalculateRiskScore"
    },

    "CalculateRiskScore": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${RiskScorerFunctionArn}",
        "Payload.$": "$"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleWorkflowFailure"
        }
      ],
      "Next": "EvaluateRiskDecision"
    },

    "EvaluateRiskDecision": {
      "Type": "Choice",
      "Choices": [
        {
          "Or": [
            {
              "Variable": "$.risk.score",
              "NumericGreaterThanEquals": 70
            },
            {
              "Variable": "$.risk.requires_manual_review",
              "BooleanEquals": true
            },
            {
              "Variable": "$.risk.vendor_trusted",
              "BooleanEquals": false
            },
            {
              "Variable": "$.risk.recommendation",
              "StringEquals": "FLAG_FOR_MANUAL_REVIEW"
            }
          ],
          "Next": "RequestManualApproval"
        }
      ],
      "Default": "AutoApprove"
    },

    "RequestManualApproval": {
      "Type": "Task",
      "Comment": "Suspends workflow on waitForTaskToken; stores token in DynamoDB via ReviewHandlerFunction and alerts SNS",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${ReviewHandlerFunctionArn}",
        "Payload": {
          "document_id.$": "$.document_id",
          "task_token.$": "$$.Task.Token",
          "risk.$": "$.risk",
          "extracted_data.$": "$.extracted_data"
        }
      },
      "TimeoutSeconds": 604800,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleWorkflowFailure"
        }
      ],
      "Next": "UpdateDynamoDBStatus"
    },

    "AutoApprove": {
      "Type": "Pass",
      "Parameters": {
        "document_id.$": "$.document_id",
        "status": "APPROVED",
        "decision": "AUTO_APPROVED",
        "risk.$": "$.risk",
        "extracted_data.$": "$.extracted_data",
        "security_scan.$": "$.security_scan",
        "message": "Low anomaly risk score; straight-through processing auto-approved."
      },
      "Next": "UpdateDynamoDBStatus"
    },

    "HandleWorkflowFailure": {
      "Type": "Pass",
      "Parameters": {
        "document_id.$": "$.document_id",
        "status": "FAILED",
        "decision": "SYSTEM_FAILED",
        "error.$": "$.error",
        "message": "Step Functions workflow encountered a failure."
      },
      "Next": "UpdateDynamoDBStatus"
    },

    "UpdateDynamoDBStatus": {
      "Type": "Task",
      "Comment": "Direct AWS SDK integration: writes final decision to DynamoDB without Lambda",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${DocuFlowTableName}",
        "Key": {
          "PK": {
            "S.$": "States.Format('DOC#{}', $.document_id)"
          },
          "SK": {
            "S": "METADATA"
          }
        },
        "UpdateExpression": "SET #st = :st, decision = :dec, completion_message = :msg, updated_at = :now REMOVE task_token",
        "ExpressionAttributeNames": {
          "#st": "status"
        },
        "ExpressionAttributeValues": {
          ":st": {
            "S.$": "$.status"
          },
          ":dec": {
            "S.$": "$.decision"
          },
          ":msg": {
            "S.$": "$.message"
          },
          ":now": {
            "S.$": "$$.Execution.StartTime"
          }
        }
      },
      "ResultPath": "$.dynamodb_result",
      "Next": "PublishNotificationSNS"
    },

    "PublishNotificationSNS": {
      "Type": "Task",
      "Comment": "Direct AWS SDK integration: dispatches final notification to Amazon SNS without Lambda",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${DocuFlowNotificationTopicArn}",
        "Subject.$": "States.Format('DocuFlow AI: Document {} Finalized ({})', $.document_id, $.status)",
        "Message.$": "States.Format('DocuFlow AI Notification: Document {} finalized with status {}. Decision: {}. Message: {}', $.document_id, $.status, $.decision, $.message)"
      },
      "ResultPath": "$.sns_result",
      "End": true
    }
  }
}
